# Copy to .env (gitignored) and fill in. Never commit real values.
# The app runs with none of these set: trips stay in memory, the dashboard reads
# trips.csv, complaints use a template, and voice logging falls back to typing.

# --- IBM (the intelligence layer) ---
# IBM Cloud API key: used for watsonx.ai and Watson Speech to Text.
# Create one with: ibmcloud iam api-key-create riderecord
IBMCLOUD_API_KEY=

# watsonx.ai (Granite): extracts incidents from speech and drafts complaints.
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Project ID: watsonx.ai > your project > Manage > General
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Watson Speech to Text: instance URL from IBM Cloud > the STT instance > Manage.
# Looks like https://api.us-south.speech-to-text.watson.cloud.ibm.com/instances/<id>
STT_URL=
# Only if the STT instance needs its own key; otherwise IBMCLOUD_API_KEY is used.
STT_API_KEY=

# --- Google Cloud (the app and data layer) ---
# Local dev against real Firestore/BigQuery needs: gcloud auth application-default login
# true: store trips in Firestore. false: keep them in memory.
USE_FIRESTORE=false
# project.dataset.table of the synthetic trips. Empty: read trips.csv instead.
BIGQUERY_TABLE=

# Deploy only (scripts/deploy.sh)
GCP_PROJECT_ID=
GCP_REGION=us-central1
