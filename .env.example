# Copy to .env (gitignored) and fill in. Never commit real values.

# IBM Cloud API key: used by the backend for watsonx.ai and by scripts/deploy.sh.
# Create one with: ibmcloud iam api-key-create commute-check
IBMCLOUD_API_KEY=

# watsonx.ai
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Project ID: watsonx.ai > your project > Manage > General
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Optional: Google Maps Platform key for transit routing
GOOGLE_MAPS_API_KEY=

# Deploy only: IBM Container Registry namespace (must be unique within us.icr.io)
CR_NAMESPACE=midevfest-commute-check
